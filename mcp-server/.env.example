# Copy to .env and fill in REAL values. NEVER commit .env to git.
# Generate token: openssl rand -hex 32

# REQUIRED
MCP_BEARER_TOKEN=787***********78cf
MCP_PORT=8000

# Workspace quota enforced by MCP file operations; larger limits require approval.
MCP_WORKSPACE_LIMIT_GB=5

# OPTIONAL: The ONLY folder on host exposed to the AI agent.
# DO NOT set this to /, /home, C:\, Documents, Desktop, or any folder containing secrets.
# Defaults to ../workspace (the repository's top-level workspace) when unset.
# run.sh resolves this once; MCP tools and nested command containers share it.
PROJECT_FOLDER_ON_HOST=../workspace

# OPTIONAL: Set your ngrok static domain to keep the same URL across restarts.
# If empty or unset, ngrok assigns a temporary URL each time.
NGROK_STATIC_DOMAIN=


# curl -H "Authorization: Bearer 787***********78cf" \
#   https://caribou-proper-kangaroo.ngrok-free.app/mcp \
#   -X POST -d '{"jsonrpc":"2.0","method":"initialize","id":1}'
